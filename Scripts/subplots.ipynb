    "fig = plt.figure(figsize=(16, 13))\n",
    "gs = gridspec.GridSpec(2, 4, figure=fig, width_ratios=[1, 1, 1.4, 0.6], height_ratios=[3, 1], wspace=0., hspace=0.)\n",
    "fig.subplots_adjust(hspace=-0.5)\n",
    "\n",
    "ax1 = fig.add_subplot(gs[0,:2])\n",
    "ax2 = fig.add_subplot(gs[0,2:])\n",
    "ax3 = fig.add_subplot(gs[1,:3])\n",
    "ax4 = fig.add_subplot(gs[1,3])\n",
    "axes = [ax1, ax2, ax3, ax4]\n",
    "\n",
    "image_dir = \"../Figures\"\n",
    "list_of_subplots = ['storm_paper_ice_ages_2017_Fraser.png', 'storm_paper_ice_ages_2017.png', '2017_comparison.png', 'storm_paper_ice_ages_legend_vertical.png']\n",
    "path_list = [os.path.join(image_dir, i) for i in list_of_subplots]\n",
    "\n",
    "for ax, img_path in zip(axes, path_list):\n",
    "    img = mpimg.imread(img_path)\n",
    "    ax.imshow(img)\n",
    "    ax.axis('off')\n",
    "ax1.set_title(r'$\\bf{(a)}$', fontsize=16, x=0.01, y=0.988, ha='left')\n",
    "ax2.set_title(r'$\\bf{(b)}$', fontsize=16, x=0.01, y=0.988, ha='left')\n",
    "ax3.set_title(r'$\\bf{(c)}$', fontsize=16, x=0.01, y=0.988, ha='left')\n",
    "\n",
    "plt.savefig('../Figures/all_2017', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
