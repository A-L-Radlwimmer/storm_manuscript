   "source": [
    "# 1. Isolate the variable\n",
    "formation_layer = ds['formation_date_int']\n",
    "\n",
    "# 2. Promote 'x' and 'y' variables to Coordinates\n",
    "# We also rename them to 'X' and 'Y' to match your dimension names exactly\n",
    "formation_layer = formation_layer.assign_coords({\n",
    "    \"X\": ds[\"x\"], \n",
    "    \"Y\": ds[\"y\"]\n",
    "})\n",
    "\n",
    "# 3. Tell rioxarray which coordinates are the spatial axes\n",
    "formation_layer = formation_layer.rio.set_spatial_dims(x_dim=\"X\", y_dim=\"Y\")\n",
    "\n",
    "# 4. Write the CRS (EPSG:3031 is the standard for Fraser et al. data)\n",
    "#formation_layer.rio.write_crs(\"EPSG:3031\", inplace=True)\n",
    "formation_layer.rio.write_crs(\"EPSG:3412\", inplace=True)\n",
    "\n",
    "# 5. Export to GeoTIFF\n",
    "# 'recalc_transform=True' ensures QGIS sees the spatial extent immediately\n",
    "formation_layer.rio.to_raster(\"fast_ice_formation_date_new.tif\", recalc_transform=True)"
   ]
