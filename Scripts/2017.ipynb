    "# Add ice-ages"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "ce2a17c0-f230-4393-9c8d-0c788364c9d8",
   "metadata": {},
   "outputs": [],
   "source": [
    "ice = ds.Fast_Ice_Time_series.compute()\n",
    "time = ds.time.compute()\n",
    "last = ice.isel(time=-1)\n",
    "\n",
    "fast_ice = last.isin([4, 5, 6])\n",
    "\n",
    "ice_rev = ice.isel(time=slice(None, None, -1))\n",
    "zero_rev = ice_rev == 0\n",
    "last_zero_rev_idx = zero_rev.argmax(dim=\"time\")\n",
    "had_zero = zero_rev.any(dim=\"time\")\n",
    "last_zero_idx = (ice.sizes[\"time\"] - 1) - last_zero_rev_idx\n",
    "\n",
    "formation_date = xr.full_like(last, fill_value=np.datetime64(\"NaT\"), dtype=\"datetime64[ns]\")\n",
    "formation_date = formation_date.where(~(fast_ice & had_zero), time.isel(time=last_zero_idx))"
   ]
  },
