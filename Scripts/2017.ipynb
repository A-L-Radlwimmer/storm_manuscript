   "source": [
    "# 1. Start with the month (1-12)\n",
    "# 2. Fill the NaT values (which represent multi-year ice in your logic) with 0\n",
    "formation_date_int = formation_date.dt.month.fillna(0).astype(np.int16)\n",
    "\n",
    "# 3. Optional: Mask out areas that aren't fast ice at all (e.g., open water/land)\n",
    "# This ensures only your 'fast_ice' pixels have 0-12, others stay -1 or NaN\n",
    "formation_date_int = formation_date_int.where(fast_ice, -1)\n",
    "\n",
    "ds = ds.assign(\n",
    "    formation_date=formation_date,\n",
    "    formation_date_int=formation_date_int\n",
    ")\n",
    "\n",
    "ds"
   ]
